# Acer WMI NitroSense Fan and Thermal Profile permissions for non-root users
SUBSYSTEM=="platform", DRIVER=="acer-wmi", RUN+="/bin/sh -c 'for path in /sys/devices/platform/acer-wmi/nitro_sense/fan_speed /sys/devices/platform/acer-wmi/nitro_sense/thermal_profile /sys/devices/platform/acer-wmi/predator_sense/fan_speed; do [ -e \"$path\" ] && chmod 0666 \"$path\" 2>/dev/null; done; for path in /sys/devices/platform/acer-wmi/platform-profile/platform-profile-*/profile; do [ -e \"$path\" ] && chmod 0666 \"$path\" 2>/dev/null; done'"

# AMD CPU Boost and Energy Performance Preference permissions
SUBSYSTEM=="cpu", RUN+="/bin/sh -c 'for path in /sys/devices/system/cpu/cpufreq/boost /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do [ -e \"$path\" ] && chmod 0666 \"$path\" 2>/dev/null; done'"

# PCIe ASPM permissions
KERNEL=="parameters", SUBSYSTEM=="module", RUN+="/bin/sh -c '[ -e /sys/module/pcie_aspm/parameters/policy ] && chmod 0666 /sys/module/pcie_aspm/parameters/policy 2>/dev/null'"
